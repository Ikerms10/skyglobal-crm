NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
THUMBTACK_WEBHOOK_SECRET=your-webhook-secret-here

# Optional: Only needed for the Thumbtack webhook to bypass RLS
# Get from Supabase Dashboard → Settings → API → service_role key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Google Drive auto-folder integration (lead/project folders)
# OAuth client: console.cloud.google.com → "SkyGlobal CRM" project → Drive API → OAuth Desktop credentials
# Refresh token: one-time OAuth consent flow as skyglobalsvcs@gmail.com with drive scope
# Folder IDs: from the SKYGLOBAL 2026/RESIDENTIAL and SKYGLOBAL 2026/COMMERCIAL folder URLs in Drive
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REFRESH_TOKEN=your-google-refresh-token
GOOGLE_DRIVE_RESIDENTIAL_FOLDER_ID=id-of-residential-folder
GOOGLE_DRIVE_COMMERCIAL_FOLDER_ID=id-of-commercial-folder
